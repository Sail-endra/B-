# All optional. Everything runs offline-deterministic without them; which backend
# produced a metric is recorded in every eval report.

# Answer generation, claim extraction, the groundedness judge, syllabus double-extraction
ANTHROPIC_API_KEY=

# Optional free-tier product explanation; each user must opt in in the app.
GEMINI_API_KEY=

# Embeddings (text-embedding-3-small). Without it, a local TF-IDF+SVD embedder is used.
OPENAI_API_KEY=

# FRED economic data. Without it, series are SYNTHETIC and stamped as such.
FRED_API_KEY=

# Optional cross-encoder reranker
COHERE_API_KEY=

# Optional voice input/output. These credentials stay on the backend.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Set to 1 to force offline providers. Use 0 to allow configured network providers.
COPILOT_OFFLINE=0

ANSWER_MODEL=claude-sonnet-4-5
CHEAP_MODEL=claude-haiku-4-5-20251001

# Optional private local answerer. Install the model in Ollama before enabling.
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_URL=http://localhost:11434
